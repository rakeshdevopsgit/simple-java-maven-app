[access]
	inheritFrom = All-Projects
[access "refs/*"]
	owner = group user/rakeshdevopsgit
[access "refs/for/refs/*"]
	read = group user/rakeshdevopsgit
	push = group user/rakeshdevopsgit
	label-Code-Review = -2..+2 group user/rakeshdevopsgit
	label-Verified = -1..+1 group user/rakeshdevopsgit
	rebase = group user/rakeshdevopsgit
	removeReviewer = group user/rakeshdevopsgit
	submit = group user/rakeshdevopsgit
[access "refs/heads/*"]
	read = group user/rakeshdevopsgit
	create = group user/rakeshdevopsgit
	push = +force group user/rakeshdevopsgit
	pushMerge = group user/rakeshdevopsgit
[access "refs/tags/*"]
	push = group user/rakeshdevopsgit
	push = +force group user/rakeshdevopsgit
